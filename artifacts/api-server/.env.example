# ==============================================================================
# MFMCF FUNAAB API SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Admin Studio Password (required for /admin authentication)
ADMIN_PASSWORD=executive

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Neon (Recommended - https://neon.tech):
# DATABASE_URL=postgresql://user:password@ep-something.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Supabase (https://supabase.com):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mfmcf
DATABASE_URL=

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
# Cloudflare R2 provides 10 GB free storage with ZERO egress/bandwidth fees.
# Create a bucket in Cloudflare Dashboard -> R2 -> Create Bucket, then
# create API tokens in R2 -> Manage R2 API Tokens.
#
# Cloudflare Account ID (found on the right sidebar of Cloudflare Dashboard)
R2_ACCOUNT_ID=
# Cloudflare R2 Access Key ID
R2_ACCESS_KEY_ID=
# Cloudflare R2 Secret Access Key
R2_SECRET_ACCESS_KEY=
# Bucket Name (e.g. mfmcf-media)
R2_BUCKET_NAME=
# Optional Public R2 CDN domain or custom domain (e.g. https://pub-xxx.r2.dev or https://media.yourdomain.org)
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Allow specific origins or * (comma-separated if multiple, e.g. https://mfmcf-funaab.pages.dev)
CORS_ORIGIN=*
